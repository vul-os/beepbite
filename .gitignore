# Env files — commit only the .example sibling. Matched by prefix (not the
# four exact names this used to list) so a renamed/backed-up copy — e.g. an
# agent doing `mv .env .env.bak-sweep` to run a gate that needs .env absent —
# is still covered instead of showing up as an untracked, unignored file that
# a later `git add` could commit. .env.example is the one deliberately
# tracked sibling and is re-included below.
.env
.env.*
!.env.example

# Go build artifacts
backend/bin/
backend/tmp/
backend/beepbite-server-local
backend/beepbite-server-*

# Local workspace for the -tags patala build (see backend/Makefile's go.work
# target). Wires the sibling patala-go module in for local cgo dev/test only
# — never committed, and never needed by the default backend build.
backend/go.work
backend/go.work.sum

.vscode

playwright-report
# Playwright test artifacts
test-results/

